# Copie este arquivo para ".env" e preencha a chave.
# Pegue sua chave em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Porta do servidor (opcional)
PORT=3000

# Modelo usado para ler os prints (opcional).
# Vision + structured outputs. Opções (jun/2026):
#   gpt-5.4-mini  -> recomendado (preciso e barato)
#   gpt-5.4-nano  -> mais barato
#   gpt-5.4       -> máxima precisão
#   gpt-4o        -> só se sua conta tiver acesso ao legado
OPENAI_MODEL=gpt-5.4-mini

# ---- Login (acesso ao sistema) ----
# Credenciais do usuário admin. Se não preencher, o padrão é:
#   admin@lastone.com / admin   (troque em produção!)
AUTH_EMAIL=admin@lastone.com
AUTH_PASSWORD=admin
# Segredo que assina o cookie de sessão. Use um valor longo e aleatório.
# Ex.: gere com  ->  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=troque-por-um-segredo-longo-e-aleatorio
